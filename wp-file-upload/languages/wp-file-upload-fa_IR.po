#: lib/wfu_attributes.php:572 lib/wfu_attributes.php:604
#: lib/wfu_attributes.php:636
msgid "enter a group value"
msgstr "یک مقدار گروه وارد کنید"

#: lib/wfu_attributes.php:574
msgid ""
"define the format of the date field as follows:&#10;  d - day of month (no "
"leading zero)&#10;  dd - day of month (two digit)&#10;  o - day of the year "
"(no leading zeros)&#10;  oo - day of the year (three digit)&#10;  D - day "
"name short&#10;  DD - day name long&#10;  m - month of year (no leading "
"zero)&#10;  mm - month of year (two digit)&#10;  M - month name short&#10;  "
"MM - month name long&#10;  y - year (two digit)&#10;  yy - year (four "
"digit)&#10;  @ - Unix timestamp (ms since 01/01/1970)&#10;  ! - Windows "
"ticks (100ns since 01/01/0001)&#10;  &#39;...&#39; - literal text&#10;  "
"&#39;&#39; - single quote&#10;  anything else - literal text&#10;the format "
"must be in parenthesis ()"
msgstr ""
"قالب فیلد تاریخ را به‌صورت زیر تعریف کنید:&#10;  d - روز ماه (بدون صفر "
"ابتدایی)&#10;  dd - روز ماه (دو رقمی)&#10;  o - روز سال (بدون صفرهای "
"ابتدایی)&#10;  oo - روز سال (سه رقمی)&#10;  D - نام کوتاه روز&#10;  DD - نام "
"بلند روز&#10;  m - ماه سال (بدون صفر ابتدایی)&#10;  mm - ماه سال (دو "
"رقمی)&#10;  M - نام کوتاه ماه&#10;  MM - نام بلند ماه&#10;  y - سال (دو "
"رقمی)&#10;  yy - سال (چهار رقمی)&#10;  @ - مهر زمانی یونیکس (میلی‌ثانیه از "
"01/01/1970)&#10;  ! - تیک‌های ویندوز (100ns از 01/01/0001)&#10;  "
"&#39;...&#39; - متن تحت‌اللفظی&#10;  &#39;&#39; - تک‌کوتیشن&#10;  هر چیز دیگر "
"- متن تحت‌اللفظی&#10;قالب باید داخل پرانتز () باشد"

#: lib/wfu_attributes.php:578
msgid "Time"
msgstr "زمان"

#: lib/wfu_attributes.php:585
msgid "if checked, then a time must be entered before file upload"
msgstr "اگر علامت‌گذاری شود، یک زمان باید قبل از بارگذاری فایل وارد شود"

#: lib/wfu_attributes.php:599
msgid ""
"enter a default time for the field or leave it empty if you do not want a "
"default value"
msgstr ""
"یک زمان پیش‌فرض برای فیلد وارد کنید یا اگر مقدار پیش‌فرض نمی‌خواهید آن را خالی "
"بگذارید"

#: lib/wfu_attributes.php:606
msgid ""
"define the format of the time field as follows:&#10;  H - hour with no "
"leading 0 (24 hour)&#10;  HH - hour with leading 0 (24 hour)&#10;  h - hour "
"with no leading 0 (12 hour)&#10;  hh - hour with leading 0 (12 hour)&#10;  m "
"- minute with no leading 0&#10;  mm - minute with leading 0&#10;  s - second "
"with no leading 0&#10;  ss - second with leading 0&#10;  l - milliseconds "
"always with leading 0&#10;  c - microseconds always with leading 0&#10;  t - "
"a or p for AM/PM&#10;  T - A or P for AM/PM&#10;  tt - am or pm for AM/"
"PM&#10;  TT - AM or PM for AM/PM&#10;  z - timezone as defined by "
"timezoneList&#10;  Z - timezone in Iso 8601 format (+04:45)&#10;  "
"&#39;...&#39; - literal text&#10;the format must be in parenthesis ()"
msgstr ""
"قالب فیلد زمان را به‌صورت زیر تعریف کنید:&#10;  H - ساعت بدون 0 ابتدایی (24 "
"ساعته)&#10;  HH - ساعت با 0 ابتدایی (24 ساعته)&#10;  h - ساعت بدون 0 ابتدایی "
"(12 ساعته)&#10;  hh - ساعت با 0 ابتدایی (12 ساعته)&#10;  m - دقیقه بدون 0 "
"ابتدایی&#10;  mm - دقیقه با 0 ابتدایی&#10;  s - ثانیه بدون 0 ابتدایی&#10;  "
"ss - ثانیه با 0 ابتدایی&#10;  l - میلی‌ثانیه همیشه با 0 ابتدایی&#10;  c - "
"میکروثانیه همیشه با 0 ابتدایی&#10;  t - a یا p برای AM/PM&#10;  T - A یا P "
"برای AM/PM&#10;  tt - am یا pm برای AM/PM&#10;  TT - AM یا PM برای AM/"
"PM&#10;  z - منطقه زمانی همان‌طور که توسط timezoneList تعریف شده&#10;  Z - "
"منطقه زمانی در قالب Iso 8601 (+04:45)&#10;  &#39;...&#39; - متن "
"تحت‌اللفظی&#10;قالب باید داخل پرانتز () باشد"

#: lib/wfu_attributes.php:610
msgid "DateTime"
msgstr "تاریخ/زمان"

#: lib/wfu_attributes.php:617
msgid "if checked, then a date and time must be entered before file upload"
msgstr "اگر علامت‌گذاری شود، یک تاریخ و زمان باید قبل از بارگذاری فایل وارد شود"

#: lib/wfu_attributes.php:631
msgid ""
"enter a default date and time for the field or leave it empty if you do not "
"want a default value"
msgstr ""
"یک تاریخ و زمان پیش‌فرض برای فیلد وارد کنید یا اگر مقدار پیش‌فرض نمی‌خواهید آن "
"را خالی بگذارید"

#: lib/wfu_attributes.php:638
msgid ""
"define the format of the datetime field as follows:&#10;  date(dateformat) "
"where dateformat is:&#10;    d - day of month (no leading zero)&#10;    dd - "
"day of month (two digit)&#10;    o - day of the year (no leading "
"zeros)&#10;    oo - day of the year (three digit)&#10;    D - day name "
"short&#10;    DD - day name long&#10;    m - month of year (no leading "
"zero)&#10;    mm - month of year (two digit)&#10;    M - month name "
"short&#10;    MM - month name long&#10;    y - year (two digit)&#10;    yy - "
"year (four digit)&#10;    @ - Unix timestamp (ms since 01/01/1970)&#10;    ! "
"- Windows ticks (100ns since 01/01/0001)&#10;    &#39;...&#39; - literal "
"text&#10;    &#39;&#39; - single quote&#10;    anything else - literal "
"text&#10;  time(timeformat) where timeformat is:&#10;    H - hour with no "
"leading 0 (24 hour)&#10;    HH - hour with leading 0 (24 hour)&#10;    h - "
"hour with no leading 0 (12 hour)&#10;    hh - hour with leading 0 (12 "
"hour)&#10;    m - minute with no leading 0&#10;    mm - minute with leading "
"0&#10;    s - second with no leading 0&#10;    ss - second with leading "
"0&#10;    l - milliseconds always with leading 0&#10;    c - microseconds "
"always with leading 0&#10;    t - a or p for AM/PM&#10;    T - A or P for AM/"
"PM&#10;    tt - am or pm for AM/PM&#10;    TT - AM or PM for AM/PM&#10;    z "
"- timezone as defined by timezoneList&#10;    Z - timezone in Iso 8601 "
"format (+04:45)&#10;    &#39;...&#39; - literal text"
msgstr ""
"قالب فیلد تاریخ‌زمان را به‌صورت زیر تعریف کنید:&#10;  date(dateformat) که در "
"آن dateformat عبارت است از:&#10;    d - روز ماه (بدون صفر ابتدایی)&#10;    "
"dd - روز ماه (دو رقمی)&#10;    o - روز سال (بدون صفرهای ابتدایی)&#10;    oo "
"- روز سال (سه رقمی)&#10;    D - نام کوتاه روز&#10;    DD - نام بلند "
"روز&#10;    m - ماه سال (بدون صفر ابتدایی)&#10;    mm - ماه سال (دو "
"رقمی)&#10;    M - نام کوتاه ماه&#10;    MM - نام بلند ماه&#10;    y - سال "
"(دو رقمی)&#10;    yy - سال (چهار رقمی)&#10;    @ - مهر زمانی یونیکس "
"(میلی‌ثانیه از 01/01/1970)&#10;    ! - تیک‌های ویندوز (100ns از "
"01/01/0001)&#10;    &#39;...&#39; - متن تحت‌اللفظی&#10;    &#39;&#39; - "
"تک‌کوتیشن&#10;    هر چیز دیگر - متن تحت‌اللفظی&#10;  time(timeformat) که در آن "
"timeformat عبارت است از:&#10;    H - ساعت بدون 0 ابتدایی (24 ساعته)&#10;    "
"HH - ساعت با 0 ابتدایی (24 ساعته)&#10;    h - ساعت بدون 0 ابتدایی (12 "
"ساعته)&#10;    hh - ساعت با 0 ابتدایی (12 ساعته)&#10;    m - دقیقه بدون 0 "
"ابتدایی&#10;    mm - دقیقه با 0 ابتدایی&#10;    s - ثانیه بدون 0 "
"ابتدایی&#10;    ss - ثانیه با 0 ابتدایی&#10;    l - میلی‌ثانیه همیشه با 0 "
"ابتدایی&#10;    c - میکروثانیه همیشه با 0 ابتدایی&#10;    t - a یا p برای AM/"
"PM&#10;    T - A یا P برای AM/PM&#10;    tt - am یا pm برای AM/PM&#10;    TT "
"- AM یا PM برای AM/PM&#10;    z - منطقه زمانی همان‌طور که توسط timezoneList "
"تعریف شده&#10;    Z - منطقه زمانی در قالب Iso 8601 (+04:45)&#10;    "
"&#39;...&#39; - متن تحت‌اللفظی"

#: lib/wfu_attributes.php:642
msgid "Listbox"
msgstr "کادر فهرست"

#: lib/wfu_attributes.php:649
msgid "if checked, then a list item must be selected before file upload"
msgstr "اگر علامت‌گذاری شود، یک مورد فهرست باید قبل از بارگذاری فایل انتخاب شود"

#: lib/wfu_attributes.php:665 lib/wfu_attributes.php:697
msgid "List Items"
msgstr "موارد فهرست"

#: lib/wfu_attributes.php:666 lib/wfu_attributes.php:698
msgid "enter a comma delimited list of items"
msgstr "فهرست موارد جداشده با کاما را وارد کنید"

#: lib/wfu_attributes.php:668 lib/wfu_attributes.php:700
#: lib/wfu_attributes.php:732
msgid "all items having the same group id belong to the same group"
msgstr "تمام مواردی که شناسه گروه یکسان دارند به همان گروه تعلق دارند"

#: lib/wfu_attributes.php:670 lib/wfu_attributes.php:702
msgid "enter the format of the list"
msgstr "قالب فهرست را وارد کنید"

#: lib/wfu_attributes.php:674
msgid "Dropdown"
msgstr "فهرست کشویی"

#: lib/wfu_attributes.php:681 lib/wfu_attributes.php:713
msgid ""
"if checked, then an item from the dropdown list must be selected before file "
"upload"
msgstr ""
"اگر علامت‌گذاری شود، یک مورد از فهرست کشویی باید قبل از بارگذاری فایل انتخاب "
"شود"

#: lib/wfu_attributes.php:706
msgid "Country List"
msgstr "فهرست کشورها"

#: lib/wfu_attributes.php:729
msgid "Suggested Items"
msgstr "موارد پیشنهادی"

#: lib/wfu_attributes.php:730
msgid ""
"enter a comma delimited list of suggested countries that will be shown on top"
msgstr ""
"فهرست کشورهای پیشنهادی جداشده با کاما را که در بالا نمایش داده می‌شوند وارد "
"کنید"

#: lib/wfu_attributes.php:734
msgid ""
"format how each country will be shown in the list&#10;the attributes "
"&#39;code&#39;, &#39;label&#39; and &#39;phone&#39; can be used&#10;if "
"format starts with &#39;flag&#39; then the flag of the country will also be "
"shown when Material UI theme is active"
msgstr ""
"قالب‌بندی کنید که هر کشور چگونه در فهرست نمایش داده شود&#10;ویژگی‌های "
"&#39;code&#39;، &#39;label&#39; و &#39;phone&#39; قابل استفاده هستند&#10;اگر "
"قالب با &#39;flag&#39; شروع شود، هنگامی که قالب Material UI فعال است پرچم "
"کشور نیز نمایش داده می‌شود"

#: lib/wfu_attributes.php:738
msgid "Hidden Honeypot"
msgstr "هانی‌پات پنهان"

#: lib/wfu_attributes.php:742
msgid ""
"enter the name of the honeypot field; it must be a value that bots can "
"easily recognize, like 'website' or 'URL'"
msgstr ""
"نام فیلد هانی‌پات را وارد کنید؛ باید مقداری باشد که ربات‌ها به‌راحتی بتوانند "
"تشخیص دهند، مانند 'website' یا 'URL'"

#: lib/wfu_attributes.php:785
msgid "Widget ID"
msgstr "شناسه ابزارک"

#: lib/wfu_attributes.php:800
msgid "Plugin ID"
msgstr "شناسه افزونه"

#: lib/wfu_attributes.php:812
msgid ""
"The unique id of each shortcode. When you have many shortcodes of this "
"plugin in the same page, then you must use different id for each one."
msgstr ""
"شناسه منحصربه‌فرد هر کد کوتاه. هنگامی که چندین کد کوتاه از این افزونه در همان "
"صفحه دارید، باید برای هر یک شناسه متفاوتی استفاده کنید."

#: lib/wfu_attributes.php:815
msgid "Single Button Operation"
msgstr "عملیات تک‌دکمه‌ای"

#: lib/wfu_attributes.php:827
msgid ""
"When it is activated, no Upload button will be shown, but upload will start "
"automatically as soon as files are selected."
msgstr ""
"هنگامی که فعال شود، هیچ دکمه بارگذاری نمایش داده نمی‌شود، اما بارگذاری به‌محض "
"انتخاب فایل‌ها به‌طور خودکار شروع می‌شود."

#: lib/wfu_attributes.php:830
msgid "Upload Path"
msgstr "مسیر بارگذاری"

#: lib/wfu_attributes.php:842
#, php-format
msgid ""
"This is the folder where the files will be uploaded. The path is relative to "
"wp-contents folder of your Wordpress website. The path can be dynamic by "
"including variables such as %%username%% or %%blogid%%. Please check "
"Documentation on how to use variables inside uploadpath."
msgstr ""
"این پوشه‌ای است که فایل‌ها در آن بارگذاری می‌شوند. مسیر نسبت به پوشه wp-"
"contents وب‌سایت WordPress شما است. مسیر می‌تواند با گنجاندن متغیرهایی مانند "
"%%username%% یا %%blogid%% پویا باشد. لطفاً مستندات را درباره نحوه استفاده از "
"متغیرها در داخل uploadpath بررسی کنید."

#: lib/wfu_attributes.php:845
msgid "Plugin Fit Mode"
msgstr "حالت تناسب افزونه"

#: lib/wfu_attributes.php:849
msgid "Fixed"
msgstr "ثابت"

#: lib/wfu_attributes.php:849
msgid "Responsive"
msgstr "واکنش‌گرا"

#: lib/wfu_attributes.php:857
msgid ""
"This defines how the plugin's elements will fit inside the page/post. If it "
"is set to fixed, then the plugin's element positions will remain fixed no "
"matter the width of the container page/post. If it is set to responsive, "
"then the plugin's elements will wrap to fit the width of the container page/"
"post."
msgstr ""
"این تعریف می‌کند که اجزای افزونه چگونه در داخل صفحه/نوشته جای می‌گیرند. اگر "
"روی fixed تنظیم شود، موقعیت‌های اجزای افزونه بدون توجه به عرض صفحه/نوشته "
"دربرگیرنده ثابت می‌مانند. اگر روی responsive تنظیم شود، اجزای افزونه برای "
"متناسب شدن با عرض صفحه/نوشته دربرگیرنده می‌پیچند."

#: lib/wfu_attributes.php:860
msgid "Allow No File"
msgstr "اجازه بدون فایل"

#: lib/wfu_attributes.php:872
msgid ""
"When it is activated a user can submit the upload form even if a file is not "
"selected."
msgstr ""
"هنگامی که فعال شود، کاربر می‌تواند فرم بارگذاری را حتی اگر فایلی انتخاب نشده "
"باشد ارسال کند."

#: lib/wfu_attributes.php:875
msgid "Reset Form Mode"
msgstr "حالت بازنشانی فرم"

#: lib/wfu_attributes.php:879
msgid "Always"
msgstr "همیشه"

#: lib/wfu_attributes.php:879
msgid "On Success"
msgstr "در صورت موفقیت"

#: lib/wfu_attributes.php:879
msgid "Never"
msgstr "هرگز"

#: lib/wfu_attributes.php:887
msgid ""
"It defines whether the form will be reset after upload; 'always' means that "
"it will be reset in any case, 'onsuccess' means that it will be reset only "
"if upload was successful, 'never' means that it will never be reset."
msgstr ""
"تعریف می‌کند که آیا فرم پس از بارگذاری بازنشانی شود؛ 'always' به معنای "
"بازنشانی در هر صورت، 'onsuccess' به معنای بازنشانی فقط در صورت موفقیت‌آمیز "
"بودن بارگذاری، 'never' به معنای عدم بازنشانی هرگز است."

#: lib/wfu_attributes.php:890
msgid "Upload Roles"
msgstr "نقش‌های بارگذاری"

#: lib/wfu_attributes.php:902
msgid ""
"Defines the categories (roles) of users allowed to upload files. Multiple "
"selections can be made. If 'Select All' is checked, then all logged users "
"can upload files. If 'Include Guests' is checked, then guests (not logged "
"users) can also upload files. Default value is 'all,guests'."
msgstr ""
"دسته‌ها (نقش‌ها) کاربران مجاز به بارگذاری فایل‌ها را تعریف می‌کند. می‌توان چندین "
"انتخاب انجام داد. اگر 'انتخاب همه' علامت‌گذاری شود، تمام کاربران وارد‌شده "
"می‌توانند فایل‌ها را بارگذاری کنند. اگر 'شامل مهمانان' علامت‌گذاری شود، مهمانان "
"(کاربران وارد‌نشده) نیز می‌توانند فایل‌ها را بارگذاری کنند. مقدار پیش‌فرض "
"'all,guests' است."

#: lib/wfu_attributes.php:905
msgid "Allowed File Extensions"
msgstr "پسوندهای فایل مجاز"

#: lib/wfu_attributes.php:917
msgid ""
"Defines the allowed file extensions. Multiple extentions can be defined, "
"separated with comma (,)."
msgstr ""
"پسوندهای فایل مجاز را تعریف می‌کند. می‌توان چندین پسوند تعریف کرد که با کاما "
"(,) جدا شده‌اند."

#: lib/wfu_attributes.php:920
msgid "Allowed File Size"
msgstr "اندازه فایل مجاز"

#: lib/wfu_attributes.php:932
msgid ""
"Defines the allowed file size in MBytes. Files larger than maxsize will not "
"be uploaded. Floating point numbers can be used (e.g. '2.5')."
msgstr ""
"اندازه فایل مجاز به مگابایت را تعریف می‌کند. فایل‌های بزرگ‌تر از maxsize "
"بارگذاری نمی‌شوند. می‌توان از اعداد اعشاری استفاده کرد (مثلاً '2.5')."

#: lib/wfu_attributes.php:935
msgid "Create Upload Path"
msgstr "ایجاد مسیر بارگذاری"

#: lib/wfu_attributes.php:947
msgid ""
"If activated then the plugin will attempt to create the upload path, if it "
"does not exist."
msgstr ""
"اگر فعال شود، افزونه تلاش می‌کند مسیر بارگذاری را ایجاد کند، اگر وجود نداشته "
"باشد."

#: lib/wfu_attributes.php:950
msgid "Do Not Change Filename"
msgstr "نام فایل را تغییر ندهید"

#: lib/wfu_attributes.php:962
msgid ""
"The plugin by default will modify the filename if it contains invalid or non-"
"english characters. By enabling this attribute the plugin will not change "
"the filename."
msgstr ""
"افزونه به‌طور پیش‌فرض نام فایل را در صورتی که حاوی کاراکترهای نامعتبر یا "
"غیرانگلیسی باشد تغییر می‌دهد. با فعال‌سازی این ویژگی، افزونه نام فایل را تغییر "
"نمی‌دهد."

#: lib/wfu_attributes.php:965
msgid "Folder Access Method"
msgstr "روش دسترسی پوشه"

#: lib/wfu_attributes.php:969
msgid "Normal"
msgstr "عادی"

#: lib/wfu_attributes.php:977
msgid ""
"Some times files cannot be uploaded to the upload folder because of read/"
"write permissions. A workaround is to use ftp to transfer the files, however "
"ftp credentials must be declared, so use carefully and only if necessary."
msgstr ""
"گاهی اوقات فایل‌ها به دلیل مجوزهای خواندن/نوشتن نمی‌توانند در پوشه بارگذاری "
"بارگذاری شوند. یک راه‌حل استفاده از ftp برای انتقال فایل‌ها است، اما "
"اعتبارنامه‌های ftp باید اعلام شوند، بنابراین با احتیاط و فقط در صورت لزوم "
"استفاده کنید."

#: lib/wfu_attributes.php:980
msgid "FTP Access Credentials"
msgstr "اعتبارنامه‌های دسترسی FTP"

#: lib/wfu_attributes.php:992
msgid ""
"If FTP access method is selected, then FTP credentials must be declared "
"here, in the form username:password@ftpdomain:port, e.g. "
"myusername:mypass@ftpdomain.com:80. Port can be ommitted. The user can "
"select Secure FTP (SFTP) by putting the prefix 's' before the port number, "
"e.g. myusername:mypass@ftpdomain.com:s22, or FTP over TLS (FTPS) by putting "
"the suffix 's' after the port number, e.g. "
"myusername:mypass@ftpdomain.com:21s (in this case a port number must be "
"defined)."
msgstr ""
"اگر روش دسترسی FTP انتخاب شود، اعتبارنامه‌های FTP باید در اینجا اعلام شوند، "
"به شکل username:password@ftpdomain:port، مثلاً "
"myusername:mypass@ftpdomain.com:80. پورت می‌تواند حذف شود. کاربر می‌تواند با "
"قرار دادن پیشوند 's' قبل از شماره پورت، Secure FTP (SFTP) را انتخاب کند، "
"مثلاً myusername:mypass@ftpdomain.com:s22، یا با قرار دادن پسوند 's' بعد از "
"شماره پورت، FTP over TLS (FTPS) را، مثلاً myusername:mypass@ftpdomain.com:21s "
"(در این حالت یک شماره پورت باید تعریف شود)."

#: lib/wfu_attributes.php:995
msgid "Use FTP Domain"
msgstr "استفاده از دامنه FTP"

#: lib/wfu_attributes.php:1007
msgid ""
"If FTP access method is selected, then sometimes the FTP domain is different "
"than the domain of your Wordpress installation. In this case, enable this "
"attribute if upload of files is not successful."
msgstr ""
"اگر روش دسترسی FTP انتخاب شود، گاهی اوقات دامنه FTP با دامنه نصب WordPress "
"شما متفاوت است. در این حالت، اگر بارگذاری فایل‌ها موفق نبود این ویژگی را فعال "
"کنید."

#: lib/wfu_attributes.php:1010
msgid "FTP Passive Mode"
msgstr "حالت غیرفعال FTP"

#: lib/wfu_attributes.php:1022
msgid ""
"If files fail to upload to the ftp domain then switching to passive FTP mode "
"may solve the problem."
msgstr ""
"اگر فایل‌ها در بارگذاری به دامنه ftp ناموفق باشند، تغییر به حالت غیرفعال FTP "
"ممکن است مشکل را حل کند."

#: lib/wfu_attributes.php:1025
msgid "Permissions of Uploaded File"
msgstr "مجوزهای فایل بارگذاری‌شده"

#: lib/wfu_attributes.php:1037
msgid ""
"Force the uploaded files to have specific permissions. This is a 4-digit "
"octal number, e.g. 0777. If left empty, then the ftp server will define the "
"permissions."
msgstr ""
"اجبار فایل‌های بارگذاری‌شده به داشتن مجوزهای خاص. این یک عدد اکتال 4 رقمی است، "
"مثلاً 0777. اگر خالی گذاشته شود، سرور ftp مجوزها را تعریف می‌کند."

#: lib/wfu_attributes.php:1040
msgid "Show Upload Folder Path"
msgstr "نمایش مسیر پوشه بارگذاری"

#: lib/wfu_attributes.php:1052
msgid "It defines if a label with the upload directory will be shown."
msgstr "تعریف می‌کند که آیا برچسبی با دایرکتوری بارگذاری نمایش داده شود."

#: lib/wfu_attributes.php:1055
msgid "Select Subfolder"
msgstr "انتخاب زیرپوشه"

#: lib/wfu_attributes.php:1067
msgid ""
"If enabled then user can select the upload folder from a drop down list. The "
"list is defined in subfoldertree attribute. The folder paths are relative to "
"the path defined in uploadpath."
msgstr ""
"اگر فعال باشد، کاربر می‌تواند پوشه بارگذاری را از یک فهرست کشویی انتخاب کند. "
"فهرست در ویژگی subfoldertree تعریف شده است. مسیرهای پوشه نسبت به مسیر "
"تعریف‌شده در uploadpath هستند."

#: lib/wfu_attributes.php:1070
msgid "List of Subfolders"
msgstr "فهرست زیرپوشه‌ها"

#: lib/wfu_attributes.php:1082
msgid ""
"The list of folders a user can select. Please see documentation on how to "
"create the list of folders. If 'Auto-populate list' is selected, then the "
"list will be filled automatically with the first-level subfolders inside the "
"directory defined by uploadpath. If 'List is editable' is selected, then the "
"user will have the capability to type the subfolder and filter the subfolder "
"list and/or define a new subfolder."
msgstr ""
"فهرست پوشه‌هایی که کاربر می‌تواند انتخاب کند. لطفاً مستندات را درباره نحوه "
"ایجاد فهرست پوشه‌ها ببینید. اگر 'پر کردن خودکار فهرست' انتخاب شود، فهرست "
"به‌طور خودکار با زیرپوشه‌های سطح اول داخل دایرکتوری تعریف‌شده توسط uploadpath "
"پر می‌شود. اگر 'فهرست قابل ویرایش است' انتخاب شود، کاربر قابلیت تایپ زیرپوشه "
"و فیلتر کردن فهرست زیرپوشه و/یا تعریف یک زیرپوشه جدید را خواهد داشت."

#: lib/wfu_attributes.php:1085
msgid "File Duplicates Policy"
msgstr "سیاست موارد تکراری فایل"

#: lib/wfu_attributes.php:1089
msgid "Overwrite"
msgstr "بازنویسی"

#: lib/wfu_attributes.php:1089
msgid "Reject"
msgstr "رد"

#: lib/wfu_attributes.php:1089
msgid "Maintain Both"
msgstr "نگه‌داری هر دو"

#: lib/wfu_attributes.php:1097
msgid ""
"It determines what happens when an uploaded file has the same name with an "
"existing file. The uploaded file can overwrite the existing one, be rejected "
"or both can be kept by renaming the uploaded file according to a rule "
"defined in uniquepattern attribute."
msgstr ""
"تعیین می‌کند هنگامی که یک فایل بارگذاری‌شده نامی یکسان با فایل موجود دارد چه "
"اتفاقی می‌افتد. فایل بارگذاری‌شده می‌تواند فایل موجود را بازنویسی کند، رد شود "
"یا هر دو با تغییر نام فایل بارگذاری‌شده بر اساس قانون تعریف‌شده در ویژگی "
"uniquepattern نگه‌داری شوند."

#: lib/wfu_attributes.php:1100
msgid "File Rename Rule"
msgstr "قانون تغییر نام فایل"

#: lib/wfu_attributes.php:1104
msgid "Index"
msgstr "شاخص"

#: lib/wfu_attributes.php:1104
msgid "Datetime Stamp"
msgstr "مهر تاریخ‌زمان"

#: lib/wfu_attributes.php:1112
msgid ""
"If duplicatespolicy is set to 'maintain both', then this rule defines how "
"the uploaded file will be renamed, in order not to match an existing file. "
"An incremental index number or a datetime stamp can be included in the "
"uploaded file name to make it unique."
msgstr ""
"اگر duplicatespolicy روی 'maintain both' تنظیم شود، این قانون تعریف می‌کند که "
"فایل بارگذاری‌شده چگونه تغییر نام می‌یابد تا با یک فایل موجود مطابقت نداشته "
"باشد. یک شماره شاخص افزایشی یا مهر تاریخ‌زمان می‌تواند در نام فایل بارگذاری‌شده "
"گنجانده شود تا منحصربه‌فرد باشد."

#: lib/wfu_attributes.php:1115
msgid "Redirect after Upload"
msgstr "تغییر مسیر پس از بارگذاری"

#: lib/wfu_attributes.php:1127
msgid ""
"If enabled, the user will be redirected to a url defined in redirectlink "
"attribute upon successful upload of all the files."
msgstr ""
"اگر فعال باشد، کاربر پس از بارگذاری موفق تمام فایل‌ها به url تعریف‌شده در "
"ویژگی redirectlink هدایت می‌شود."

#: lib/wfu_attributes.php:1130
msgid "Redirection URL"
msgstr "URL تغییر مسیر"

#: lib/wfu_attributes.php:1142
msgid ""
"This is the redirect URL. The URL can be dynamic by using variables. Please "
"see Documentation on how to use variables inside attributes."
msgstr ""
"این URL تغییر مسیر است. URL می‌تواند با استفاده از متغیرها پویا باشد. لطفاً "
"مستندات را درباره نحوه استفاده از متغیرها در داخل ویژگی‌ها ببینید."

#: lib/wfu_attributes.php:1145
msgid "Show Detailed Admin Messages"
msgstr "نمایش پیام‌های تفصیلی مدیر"

#: lib/wfu_attributes.php:1157
msgid ""
"If enabled then more detailed messages about upload operations will be shown "
"to administrators for debugging or error detection."
msgstr ""
"اگر فعال باشد، پیام‌های تفصیلی‌تری درباره عملیات بارگذاری برای اشکال‌زدایی یا "
"تشخیص خطا به مدیران نمایش داده می‌شود."

#: lib/wfu_attributes.php:1160
msgid "Block Themes Compatibility Mode"
msgstr "حالت سازگاری قالب‌های بلوکی"

#: lib/wfu_attributes.php:1164
msgid "Auto"
msgstr "خودکار"

#: lib/wfu_attributes.php:1172
msgid ""
"It determines the compatibility mode for block themes. If 'auto' is selected "
"the plugin will auto-detect if the theme is block based and will adapt its "
"output accordingly. If 'on' is selected the plugin will always consider that "
"the theme is block based. If 'off' is selected there will be no adaptation "
"for block based themes."
msgstr ""
"حالت سازگاری برای قالب‌های بلوکی را تعیین می‌کند. اگر 'auto' انتخاب شود، "
"افزونه به‌طور خودکار تشخیص می‌دهد که آیا قالب مبتنی بر بلوک است و خروجی خود را "
"بر اساس آن تطبیق می‌دهد. اگر 'on' انتخاب شود، افزونه همیشه فرض می‌کند که قالب "
"مبتنی بر بلوک است. اگر 'off' انتخاب شود، هیچ تطبیقی برای قالب‌های مبتنی بر "
"بلوک وجود نخواهد داشت."

#: lib/wfu_attributes.php:1175
msgid "Disable AJAX"
msgstr "غیرفعال‌سازی AJAX"

#: lib/wfu_attributes.php:1187
msgid ""
"If AJAX is disabled, then upload of files will be performed using HTML "
"forms, meaning that page will refresh to complete the upload. Use it in case "
"that AJAX is causing problems with your page (although the plugin has an "
"auto-detection feature for checking if user's browser supports AJAX or not)."
msgstr ""
"اگر AJAX غیرفعال باشد، بارگذاری فایل‌ها با استفاده از فرم‌های HTML انجام "
"می‌شود، به این معنی که صفحه برای تکمیل بارگذاری تازه‌سازی می‌شود. در صورتی که "
"AJAX با صفحه شما مشکل ایجاد می‌کند از آن استفاده کنید (اگرچه افزونه یک ویژگی "
"تشخیص خودکار برای بررسی اینکه آیا مرورگر کاربر از AJAX پشتیبانی می‌کند یا نه "
"دارد)."

#: lib/wfu_attributes.php:1190 lib/wfu_constants.php:217
msgid "Test Mode"
msgstr "حالت تست"

#: lib/wfu_attributes.php:1202
msgid ""
"If enabled then the plugin will be shown in test mode, meaning that all "
"selected features will be shown but no upload will be possible. Use it to "
"review how the plugin looks like and style it according to your needs."
msgstr ""
"اگر فعال باشد، افزونه در حالت آزمایش نمایش داده می‌شود، به این معنی که تمام "
"ویژگی‌های انتخاب‌شده نمایش داده می‌شوند اما هیچ بارگذاری‌ای امکان‌پذیر نیست. از "
"آن برای بررسی نحوه ظاهر افزونه و استایل‌دهی آن مطابق نیازهای خود استفاده کنید."

#: lib/wfu_attributes.php:1205
msgid "Debug Mode"
msgstr "حالت اشکال‌زدایی"

#: lib/wfu_attributes.php:1217
msgid ""
"If enabled then the plugin will show to administrators any internal PHP "
"warnings and errors generated during the upload process inside the message "
"box."
msgstr ""
"اگر فعال باشد، افزونه هرگونه هشدار و خطای داخلی PHP تولیدشده در طول فرآیند "
"بارگذاری را داخل کادر پیام به مدیران نمایش می‌دهد."

#: lib/wfu_attributes.php:1232
msgid ""
"It defines the positions of the selected plugin components. Drag the "
"components from the right pane and drop them to the left one to define your "
"own component positions."
msgstr ""
"موقعیت‌های اجزای انتخاب‌شده افزونه را تعریف می‌کند. اجزا را از پنجره راست بکشید "
"و در پنجره چپ رها کنید تا موقعیت‌های اجزای خود را تعریف کنید."

#: lib/wfu_attributes.php:1235
msgid "Plugin Title"
msgstr "عنوان افزونه"

#: lib/wfu_attributes.php:1247
msgid "A text representing the title of the plugin."
msgstr "متنی که نشان‌دهنده عنوان افزونه است."

#: lib/wfu_attributes.php:1250
msgid "Select Button Caption"
msgstr "عنوان دکمه انتخاب"

#: lib/wfu_attributes.php:1262
msgid "The caption of the button that selects the files for upload."
msgstr "عنوان دکمه‌ای که فایل‌ها را برای بارگذاری انتخاب می‌کند."

#: lib/wfu_attributes.php:1265
msgid "Upload Button Caption"
msgstr "عنوان دکمه بارگذاری"

#: lib/wfu_attributes.php:1277
msgid "The caption of the button that starts the upload."
msgstr "عنوان دکمه‌ای که بارگذاری را شروع می‌کند."

#: lib/wfu_attributes.php:1292
msgid ""
"This is the label before the upload folder path, if the path is selected to "
"be shown using the showtargetfolder attribute."
msgstr ""
"این برچسب قبل از مسیر پوشه بارگذاری است، اگر مسیر برای نمایش با استفاده از "
"ویژگی showtargetfolder انتخاب شده باشد."

#: lib/wfu_attributes.php:1295
msgid "Select Subfolder Label"
msgstr "برچسب انتخاب زیرپوشه"

#: lib/wfu_attributes.php:1307
msgid ""
"This is the label of the subfolder dropdown list. It is active when "
"askforsubfolders attribute is on."
msgstr ""
"این برچسب فهرست کشویی زیرپوشه است. هنگامی که ویژگی askforsubfolders روشن است "
"فعال می‌شود."

#: lib/wfu_attributes.php:1310
msgid "Success Upload Message"
msgstr "پیام بارگذاری موفق"

#: lib/wfu_attributes.php:1322
msgid ""
"This is the message that will be shown for every file that has been uploaded "
"successfully."
msgstr ""
"این پیامی است که برای هر فایلی که با موفقیت بارگذاری شده نمایش داده می‌شود."

#: lib/wfu_attributes.php:1325
msgid "Warning Upload Message"
msgstr "پیام هشدار بارگذاری"

#: lib/wfu_attributes.php:1337
msgid ""
"This is the message that will be shown for every file that has been uploaded "
"with warnings."
msgstr ""
"این پیامی است که برای هر فایلی که با هشدار بارگذاری شده نمایش داده می‌شود."

#: lib/wfu_attributes.php:1340
msgid "Error Upload Message"
msgstr "پیام خطای بارگذاری"

#: lib/wfu_attributes.php:1352
msgid ""
"This is the message that will be shown for every file that has failed to "
"upload."
msgstr ""
"این پیامی است که برای هر فایلی که در بارگذاری ناموفق بوده نمایش داده می‌شود."

#: lib/wfu_attributes.php:1355
msgid "Wait Upload Message"
msgstr "پیام انتظار بارگذاری"

#: lib/wfu_attributes.php:1367
msgid "This is the message that will be shown while file is uploading."
msgstr "این پیامی است که در حین بارگذاری فایل نمایش داده می‌شود."

#: lib/wfu_attributes.php:1370
msgid "Upload Media Button Caption"
msgstr "عنوان دکمه بارگذاری رسانه"

#: lib/wfu_attributes.php:1382
msgid ""
"The caption of the button that starts the upload when media capture from the "
"webcam has been activated."
msgstr ""
"عنوان دکمه‌ای که هنگام فعال‌سازی ضبط رسانه از وب‌کم بارگذاری را شروع می‌کند."

#: lib/wfu_attributes.php:1385
msgid "Video Filename"
msgstr "نام فایل ویدیو"

#: lib/wfu_attributes.php:1397
msgid "This is the file name of the captured video file."
msgstr "این نام فایل ویدیوی ضبط‌شده است."

#: lib/wfu_attributes.php:1400
msgid "Image Filename"
msgstr "نام فایل تصویر"

#: lib/wfu_attributes.php:1412
msgid "This is the file name of the captured image file."
msgstr "این نام فایل تصویر ضبط‌شده است."

#: lib/wfu_attributes.php:1415
msgid "Required Fields Suffix"
msgstr "پسوند فیلدهای اجباری"

#: lib/wfu_attributes.php:1427
msgid ""
"This is the keyword that shows up next to user field labels in order to "
"denote that they are required."
msgstr ""
"این کلمه کلیدی است که در کنار برچسب‌های فیلد کاربر نمایش داده می‌شود تا نشان "
"دهد که اجباری هستند."

#: lib/wfu_attributes.php:1430
msgid "Notify by Email"
msgstr "اطلاع‌رسانی از طریق ایمیل"

#: lib/wfu_attributes.php:1442
msgid ""
"If activated then email will be sent to inform about successful file uploads."
msgstr ""
"اگر فعال شود، ایمیلی برای اطلاع‌رسانی درباره بارگذاری‌های موفق فایل ارسال "
"می‌شود."

#: lib/wfu_attributes.php:1445
msgid "Email Recipients"
msgstr "گیرندگان ایمیل"

#: lib/wfu_attributes.php:1457
msgid ""
"Defines the recipients of the email notification. Can be dynamic by using "
"variables. Please check Documentation on how to use variables in atributes."
msgstr ""
"گیرندگان اعلان ایمیل را تعریف می‌کند. می‌تواند با استفاده از متغیرها پویا "
"باشد. لطفاً مستندات را درباره نحوه استفاده از متغیرها در ویژگی‌ها بررسی کنید."

#: lib/wfu_attributes.php:1460
msgid "Email Headers"
msgstr "سرآیندهای ایمیل"

#: lib/wfu_attributes.php:1472
msgid ""
"Defines additional email headers, in case you want to sent an HTML message, "
"or use Bcc list, or use a different From address and name or other more "
"advanced email options."
msgstr ""
"سرآیندهای اضافی ایمیل را تعریف می‌کند، در صورتی که می‌خواهید یک پیام HTML "
"ارسال کنید، یا از فهرست Bcc استفاده کنید، یا از یک آدرس و نام From متفاوت یا "
"سایر گزینه‌های پیشرفته‌تر ایمیل استفاده کنید."

#: lib/wfu_attributes.php:1475
msgid "Email Subject"
msgstr "موضوع ایمیل"

#: lib/wfu_attributes.php:1487
msgid ""
"Defines the email subject. Can be dynamic by using variables. Please check "
"Documentation on how to use variables in atributes."
msgstr ""
"موضوع ایمیل را تعریف می‌کند. می‌تواند با استفاده از متغیرها پویا باشد. لطفاً "
"مستندات را درباره نحوه استفاده از متغیرها در ویژگی‌ها بررسی کنید."

#: lib/wfu_attributes.php:1490
msgid "Email Body"
msgstr "بدنه ایمیل"

#: lib/wfu_attributes.php:1502
msgid ""
"Defines the email body. Can be dynamic by using variables. Please check "
"Documentation on how to use variables in atributes."
msgstr ""
"بدنه ایمیل را تعریف می‌کند. می‌تواند با استفاده از متغیرها پویا باشد. لطفاً "
"مستندات را درباره نحوه استفاده از متغیرها در ویژگی‌ها بررسی کنید."

#: lib/wfu_attributes.php:1505
msgid "Attach Uploaded Files"
msgstr "پیوست فایل‌های بارگذاری‌شده"

#: lib/wfu_attributes.php:1517
msgid ""
"If activated, then uploaded files will be included in the notification email "
"as attachments. Please use carefully."
msgstr ""
"اگر فعال شود، فایل‌های بارگذاری‌شده به‌عنوان پیوست در اعلان ایمیل گنجانده "
"می‌شوند. لطفاً با احتیاط استفاده کنید."

#: lib/wfu_attributes.php:1520
msgid "Ask for Consent"
msgstr "درخواست رضایت"

#: lib/wfu_attributes.php:1532
msgid ""
"If activated, then consent from users will be asked for storing their "
"personal data. If users do not give consent, then their data will not be "
"stored in the database, they will only be included in the notification "
"email, if email notifications are active."
msgstr ""
"اگر فعال شود، رضایت کاربران برای ذخیره داده‌های شخصی آن‌ها درخواست می‌شود. اگر "
"کاربران رضایت ندهند، داده‌های آن‌ها در پایگاه داده ذخیره نمی‌شود، فقط در اعلان "
"ایمیل گنجانده می‌شوند، اگر اعلان‌های ایمیل فعال باشند."

#: lib/wfu_attributes.php:1535
msgid "Personal Data Types"
msgstr "انواع داده‌های شخصی"

#: lib/wfu_attributes.php:1539
msgid "Userdata and files"
msgstr "داده‌های کاربر و فایل‌ها"

#: lib/wfu_attributes.php:1547
msgid ""
"Determines which data are considered as personal data. By default only "
"userdata are considered as personal data. If the 2nd option is selected, "
"then files will also be considered as personal data. This means that if the "
"users do not give their consent, then the files will not be uploaded on the "
"website, they will only be inluded in the notification email as attachments, "
"if email notifications are active."
msgstr ""
"تعیین می‌کند کدام داده‌ها به‌عنوان داده‌های شخصی در نظر گرفته می‌شوند. به‌طور "
"پیش‌فرض فقط داده‌های کاربر به‌عنوان داده‌های شخصی در نظر گرفته می‌شوند. اگر گزینه "
"دوم انتخاب شود، فایل‌ها نیز به‌عنوان داده‌های شخصی در نظر گرفته می‌شوند. این به "
"این معنی است که اگر کاربران رضایت ندهند، فایل‌ها در وب‌سایت بارگذاری نمی‌شوند، "
"فقط به‌عنوان پیوست در اعلان ایمیل گنجانده می‌شوند، اگر اعلان‌های ایمیل فعال "
"باشند."

#: lib/wfu_attributes.php:1550
msgid "Do Not Remember Consent Answer"
msgstr "به یاد نسپردن پاسخ رضایت"

#: lib/wfu_attributes.php:1562
msgid ""
"If activated the plugin will not remember the consent answer provided by the "
"user and the consent question will always show."
msgstr ""
"اگر فعال شود، افزونه پاسخ رضایت ارائه‌شده توسط کاربر را به یاد نمی‌سپارد و "
"سؤال رضایت همیشه نمایش داده می‌شود."

#: lib/wfu_attributes.php:1565
msgid "Consent Denial Rejects Upload"
msgstr "رد رضایت باعث رد بارگذاری می‌شود"

#: lib/wfu_attributes.php:1577
msgid ""
"If activated and user has denied consent then the upload will be rejected. "
"If deactivated, then the upload will continue regardless of consent answer."
msgstr ""
"اگر فعال شود و کاربر رضایت را رد کرده باشد، بارگذاری رد می‌شود. اگر غیرفعال "
"شود، بارگذاری بدون توجه به پاسخ رضایت ادامه می‌یابد."

#: lib/wfu_attributes.php:1580
msgid "Reject Message"
msgstr "پیام رد"

#: lib/wfu_attributes.php:1592
msgid ""
"It defines the message that will appear to the user if upload cannot "
"continue due to consent denial."
msgstr ""
"پیامی را که در صورت عدم امکان ادامه بارگذاری به دلیل رد رضایت به کاربر نمایش "
"داده می‌شود تعریف می‌کند."

#: lib/wfu_attributes.php:1595
msgid "Consent Format"
msgstr "قالب رضایت"

#: lib/wfu_attributes.php:1599
msgid "Radio"
msgstr "دکمه رادیویی"

#: lib/wfu_attributes.php:1599
msgid "Prompt"
msgstr "کادر گفتگو"

#: lib/wfu_attributes.php:1607
msgid ""
"Determines how consent question will appear to the user. If 'checkbox' is "
"selected then a checkbox will appear inside the upload form which the user "
"needs to tick. If 'radio' is selected then a radio button with 'Yes' and "
"'No' answers will appear inside the form (this makes sure that the user will "
"select something after all. If 'prompt' is selected then a dialog will "
"appear on the user when pressing the upload button asking for consent."
msgstr ""
"تعیین می‌کند سؤال رضایت چگونه به کاربر نمایش داده می‌شود. اگر 'checkbox' "
"انتخاب شود، یک کادر انتخاب داخل فرم بارگذاری ظاهر می‌شود که کاربر باید آن را "
"علامت بزند. اگر 'radio' انتخاب شود، یک دکمه رادیویی با پاسخ‌های 'بله' و 'خیر' "
"داخل فرم ظاهر می‌شود (این اطمینان می‌دهد که کاربر در نهایت چیزی را انتخاب "
"خواهد کرد). اگر 'prompt' انتخاب شود، هنگام فشار دادن دکمه بارگذاری یک کادر "
"گفتگو برای کاربر ظاهر می‌شود و رضایت را درخواست می‌کند."

#: lib/wfu_attributes.php:1610
msgid "Preselected Answer"
msgstr "پاسخ از پیش انتخاب‌شده"

#: lib/wfu_attributes.php:1614
msgid "None"
msgstr "هیچ‌کدام"

#: lib/wfu_attributes.php:1622
msgid "Determines whether a default answer will be selected."
msgstr "تعیین می‌کند که آیا یک پاسخ پیش‌فرض انتخاب شود."

#: lib/wfu_attributes.php:1625
msgid "Consent Question for Checkbox"
msgstr "سؤال رضایت برای کادر انتخاب"

#: lib/wfu_attributes.php:1637
msgid ""
"Defines the question that will appear to the user next to the checkbox, or "
"radio buttons or inside the prompt dialog. If a word starting and ending "
"with semicolon (:) is added in the question, e.g. :link:, then it will be "
"replaced by a link defined in 'Consent Disclaimer Link' attribute. This way "
"a link to a disclaimer can be added."
msgstr ""
"سؤالی را که در کنار کادر انتخاب، یا دکمه‌های رادیویی یا داخل کادر گفتگو به "
"کاربر نمایش داده می‌شود تعریف می‌کند. اگر کلمه‌ای که با دونقطه (:) شروع و پایان "
"می‌یابد در سؤال اضافه شود، مثلاً :link:، با پیوندی که در ویژگی 'Consent "
"Disclaimer Link' تعریف شده جایگزین می‌شود. به این ترتیب می‌توان پیوندی به یک "
"سلب مسئولیت اضافه کرد."

#: lib/wfu_attributes.php:1640
msgid "Consent Disclaimer Link"
msgstr "پیوند سلب مسئولیت رضایت"

#: lib/wfu_attributes.php:1652
msgid ""
"Defines a link that displays a disclaimer to the user if the user presses "
"the relevant link that is included inside the consent question."
msgstr ""
"پیوندی را تعریف می‌کند که اگر کاربر روی پیوند مرتبطی که داخل سؤال رضایت "
"گنجانده شده فشار دهد، یک سلب مسئولیت به کاربر نمایش می‌دهد."

#: lib/wfu_attributes.php:1655
msgid "Enable Material UI"
msgstr "فعال‌سازی Material UI"

#: lib/wfu_attributes.php:1667
msgid ""
"If enabled the upload form will use Material UI components. Default is false."
msgstr ""
"اگر فعال باشد، فرم بارگذاری از اجزای Material UI استفاده می‌کند. پیش‌فرض false "
"است."

#: lib/wfu_attributes.php:1670
msgid "Material UI Primary Color"
msgstr "رنگ اصلی Material UI"

#: lib/wfu_attributes.php:1682
msgid "The Material UI theme primary color."
msgstr "رنگ اصلی قالب Material UI."

#: lib/wfu_attributes.php:1685
msgid "Material UI Text Color"
msgstr "رنگ متن Material UI"

#: lib/wfu_attributes.php:1697
msgid "The Material UI theme text primary color."
msgstr "رنگ اصلی متن قالب Material UI."

#: lib/wfu_attributes.php:1700
msgid "Material UI Error Color"
msgstr "رنگ خطای Material UI"

#: lib/wfu_attributes.php:1712
msgid "The Material UI theme error color."
msgstr "رنگ خطای قالب Material UI."

#: lib/wfu_attributes.php:1715
msgid "Material UI Dark Mode"
msgstr "حالت تیره Material UI"

#: lib/wfu_attributes.php:1727
msgid "If enabled Material UI will turn to dark theme."
msgstr "اگر فعال باشد، Material UI به قالب تیره تغییر می‌کند."

#: lib/wfu_attributes.php:1730
msgid "Override CSS Method"
msgstr "روش بازنویسی CSS"

#: lib/wfu_attributes.php:1734
msgid "Strong Styles To Selected"
msgstr "استایل‌های قوی برای انتخاب‌شده‌ها"

#: lib/wfu_attributes.php:1734
msgid "Strong Styles To All"
msgstr "استایل‌های قوی برای همه"

#: lib/wfu_attributes.php:1734
msgid "Layers"
msgstr "لایه‌ها"

#: lib/wfu_attributes.php:1734
msgid "Shadow DOM"
msgstr "Shadow DOM"

#: lib/wfu_attributes.php:1742
msgid ""
"The Material UI components require specific CSS. However the theme's and "
"other loaded styles may override them, causing the components not to show "
"correctly. The plugin uses some methods to override the loaded styles. The "
"first method, 'strongstyles-selected', makes the CSS selectors of some "
"Material UI styles more specific. The second method, 'strongstyles-all', "
"makes the CSS selectors of all Material UI styles more specific. The third "
"method, 'layers' uses CSS cascading layers to increase the precendence of "
"Material UI styles. The fourth method puts all Material UI components and "
"their styles in Shadow DOM."
msgstr ""
"اجزای Material UI به CSS خاصی نیاز دارند. با این حال، استایل‌های قالب و سایر "
"استایل‌های بارگذاری‌شده ممکن است آن‌ها را بازنویسی کنند و باعث شوند اجزا "
"به‌درستی نمایش داده نشوند. افزونه از برخی روش‌ها برای بازنویسی استایل‌های "
"بارگذاری‌شده استفاده می‌کند. روش اول، 'strongstyles-selected'، انتخابگرهای CSS "
"برخی استایل‌های Material UI را خاص‌تر می‌کند. روش دوم، 'strongstyles-all'، "
"انتخابگرهای CSS تمام استایل‌های Material UI را خاص‌تر می‌کند. روش سوم، "
"'layers'، از لایه‌های آبشاری CSS برای افزایش اولویت استایل‌های Material UI "
"استفاده می‌کند. روش چهارم تمام اجزای Material UI و استایل‌های آن‌ها را در "
"Shadow DOM قرار می‌دهد."

#: lib/wfu_attributes.php:1760
msgid "Success Message Colors"
msgstr "رنگ‌های پیام موفقیت"

#: lib/wfu_attributes.php:1772
msgid ""
"It defines the text, background and border color of the success message."
msgstr "رنگ متن، پس‌زمینه و حاشیه پیام موفقیت را تعریف می‌کند."

#: lib/wfu_attributes.php:1775
msgid "Warning Message Colors"
msgstr "رنگ‌های پیام هشدار"

#: lib/wfu_attributes.php:1787
msgid ""
"It defines the text, background and border color of the warning message."
msgstr "رنگ متن، پس‌زمینه و حاشیه پیام هشدار را تعریف می‌کند."

#: lib/wfu_attributes.php:1790
msgid "Fail Message Colors"
msgstr "رنگ‌های پیام ناموفق"

#: lib/wfu_attributes.php:1802
msgid ""
"It defines the text, background and border color of the fail (error) message."
msgstr "رنگ متن، پس‌زمینه و حاشیه پیام ناموفق (خطا) را تعریف می‌کند."

#: lib/wfu_attributes.php:1832
msgid "It defines the widths of the selected plugin components."
msgstr "عرض‌های اجزای انتخاب‌شده افزونه را تعریف می‌کند."

#: lib/wfu_attributes.php:1847
msgid "It defines the heights of the selected plugin components."
msgstr "ارتفاع‌های اجزای انتخاب‌شده افزونه را تعریف می‌کند."

#: lib/wfu_attributes.php:1850
msgid "Include Additional Data Fields"
msgstr "گنجاندن فیلدهای داده اضافی"

#: lib/wfu_attributes.php:1862
msgid ""
"If enabled, then user can send additional information together with uploaded "
"files (e.g. name, email etc), defined in userdatalabel attribute."
msgstr ""
"اگر فعال باشد، کاربر می‌تواند اطلاعات اضافی را همراه با فایل‌های بارگذاری‌شده "
"ارسال کند (مثلاً نام، ایمیل و غیره)، تعریف‌شده در ویژگی userdatalabel."

#: lib/wfu_attributes.php:1877
msgid ""
"It defines the labels of the additional data fields and whether they are "
"required or not."
msgstr ""
"برچسب‌های فیلدهای داده اضافی و اینکه آیا اجباری هستند یا نه را تعریف می‌کند."

#: lib/wfu_attributes.php:1880
msgid "WP Filebase Plugin Connection"
msgstr "اتصال افزونه WP Filebase"

#: lib/wfu_attributes.php:1892
msgid ""
"If enabled then the WP Filebase Plugin will be informed about new file "
"uploads."
msgstr ""
"اگر فعال باشد، افزونه WP Filebase درباره بارگذاری‌های جدید فایل مطلع می‌شود."

#: lib/wfu_attributes.php:1895
msgid "Add Uploaded Files To Media"
msgstr "افزودن فایل‌های بارگذاری‌شده به رسانه"

#: lib/wfu_attributes.php:1907
msgid ""
"If enabled then the uploaded files will be added to the Media library of "
"your Wordpress website. Please note that the upload path must be inside the "
"wp-content/uploads directory (which is the default upload path)."
msgstr ""
"اگر فعال باشد، فایل‌های بارگذاری‌شده به کتابخانه رسانه وب‌سایت WordPress شما "
"اضافه می‌شوند. لطفاً توجه داشته باشید که مسیر بارگذاری باید داخل دایرکتوری wp-"
"content/uploads باشد (که مسیر بارگذاری پیش‌فرض است)."

#: lib/wfu_attributes.php:1910
msgid "Attach Uploaded Files To Post"
msgstr "پیوست فایل‌های بارگذاری‌شده به نوشته"

#: lib/wfu_attributes.php:1922
msgid ""
"If enabled then the uploaded files will be added to the current post as "
"attachments. Please note that the upload path must be inside the wp-content/"
"uploads directory (which is the default upload path)."
msgstr ""
"اگر فعال باشد، فایل‌های بارگذاری‌شده به‌عنوان پیوست به نوشته فعلی اضافه می‌شوند. "
"لطفاً توجه داشته باشید که مسیر بارگذاری باید داخل دایرکتوری wp-content/"
"uploads باشد (که مسیر بارگذاری پیش‌فرض است)."

#: lib/wfu_attributes.php:1925
msgid "Enable Webcam"
msgstr "فعال‌سازی وب‌کم"

#: lib/wfu_attributes.php:1937
msgid ""
"This enables capturing of video or still pictures from the computer's "
"webcam. It is not supported by all browsers yet."
msgstr ""
"این ضبط ویدیو یا تصاویر ثابت از وب‌کم رایانه را فعال می‌کند. هنوز توسط همه "
"مرورگرها پشتیبانی نمی‌شود."

#: lib/wfu_attributes.php:1940
msgid "Allow File Selection"
msgstr "اجازه انتخاب فایل"

#: lib/wfu_attributes.php:1952
msgid ""
"When webcam mode is enabled, the user can only capture video or images from "
"the webcam. If this attribute is enabled, the user can also select an image "
"file using the Select File button. The selected file will be previewed in "
"the capture box."
msgstr ""
"هنگامی که حالت وب‌کم فعال است، کاربر فقط می‌تواند ویدیو یا تصاویر را از وب‌کم "
"ضبط کند. اگر این ویژگی فعال باشد، کاربر همچنین می‌تواند با استفاده از دکمه "
"انتخاب فایل یک فایل تصویر انتخاب کند. فایل انتخاب‌شده در کادر ضبط پیش‌نمایش "
"می‌شود."

#: lib/wfu_attributes.php:1955
msgid "Capture Mode"
msgstr "حالت ضبط"

#: lib/wfu_attributes.php:1959
msgid "Capture Video"
msgstr "ضبط ویدیو"

#: lib/wfu_attributes.php:1959
msgid "Take Photos"
msgstr "گرفتن عکس"

#: lib/wfu_attributes.php:1959
msgid "Both"
msgstr "هر دو"

#: lib/wfu_attributes.php:1967
msgid ""
"It defines the webcam capture mode. The webcam can either capture video, "
"still photos or both."
msgstr ""
"حالت ضبط وب‌کم را تعریف می‌کند. وب‌کم می‌تواند ویدیو، عکس‌های ثابت یا هر دو را "
"ضبط کند."

#: lib/wfu_attributes.php:1970
msgid "Capture Audio"
msgstr "ضبط صدا"

#: lib/wfu_attributes.php:1982
msgid ""
"It defines whether audio will be captured together with video from the "
"webcam."
msgstr "تعریف می‌کند که آیا صدا همراه با ویدیو از وب‌کم ضبط شود."

#: lib/wfu_attributes.php:1985
msgid "Video Width"
msgstr "عرض ویدیو"

#: lib/wfu_attributes.php:1997
msgid ""
"It requests a preferable video width for the webcam. The plugin will try to "
"match this setting as close as possible depending on webcam capabilities."
msgstr ""
"یک عرض ویدیوی ترجیحی برای وب‌کم درخواست می‌کند. افزونه تلاش می‌کند این تنظیم را "
"تا حد امکان بسته به قابلیت‌های وب‌کم مطابقت دهد."

#: lib/wfu_attributes.php:2000
msgid "Video Height"
msgstr "ارتفاع ویدیو"

#: lib/wfu_attributes.php:2012
msgid ""
"It requests a preferable video height for the webcam. The plugin will try to "
"match this setting as close as possible depending on webcam capabilities."
msgstr ""
"یک ارتفاع ویدیوی ترجیحی برای وب‌کم درخواست می‌کند. افزونه تلاش می‌کند این تنظیم "
"را تا حد امکان بسته به قابلیت‌های وب‌کم مطابقت دهد."

#: lib/wfu_attributes.php:2015
msgid "Video Aspect Ratio"
msgstr "نسبت ابعاد ویدیو"

#: lib/wfu_attributes.php:2027
msgid ""
"It requests a preferable video aspect ratio for the webcam. The plugin will "
"try to match this setting as close as possible depending on webcam "
"capabilities."
msgstr ""
"یک نسبت ابعاد ویدیوی ترجیحی برای وب‌کم درخواست می‌کند. افزونه تلاش می‌کند این "
"تنظیم را تا حد امکان بسته به قابلیت‌های وب‌کم مطابقت دهد."

#: lib/wfu_attributes.php:2030
msgid "Video Frame Rate"
msgstr "نرخ فریم ویدیو"

#: lib/wfu_attributes.php:2042
msgid ""
"It requests a preferable video frame rate for video recording. The plugin "
"will try to match this setting as close as possible depending on webcam "
"capabilities."
msgstr ""
"یک نرخ فریم ویدیوی ترجیحی برای ضبط ویدیو درخواست می‌کند. افزونه تلاش می‌کند "
"این تنظیم را تا حد امکان بسته به قابلیت‌های وب‌کم مطابقت دهد."

#: lib/wfu_attributes.php:2045
msgid "Camera Facing Mode"
msgstr "حالت جهت دوربین"

#: lib/wfu_attributes.php:2049
msgid "Any"
msgstr "هر کدام"

#: lib/wfu_attributes.php:2049
msgid "Front"
msgstr "جلو"

#: lib/wfu_attributes.php:2049
msgid "Back"
msgstr "عقب"

#: lib/wfu_attributes.php:2057
msgid ""
"It defines if the front or back camera will be preferred (for mobile devices "
"with 2 cameras). The plugin will try to match this setting depending on "
"webcam capabilities."
msgstr ""
"تعریف می‌کند که آیا دوربین جلو یا عقب ترجیح داده شود (برای دستگاه‌های موبایل "
"با 2 دوربین). افزونه تلاش می‌کند این تنظیم را بسته به قابلیت‌های وب‌کم مطابقت "
"دهد."

#: lib/wfu_attributes.php:2060
msgid "Start Camera Off"
msgstr "شروع با دوربین خاموش"

#: lib/wfu_attributes.php:2072
msgid "If enabled the camera will initially be off."
msgstr "اگر فعال باشد، دوربین در ابتدا خاموش خواهد بود."

#: lib/wfu_attributes.php:2075
msgid "Switch Camera Button"
msgstr "دکمه تعویض دوربین"

#: lib/wfu_attributes.php:2087
msgid ""
"If enabled a button will show up at the top-left corner of the capture box, "
"for switching between front and back camera."
msgstr ""
"اگر فعال باشد، یک دکمه در گوشه بالا-چپ کادر ضبط برای تعویض بین دوربین جلو و "
"عقب نمایش داده می‌شود."

#: lib/wfu_attributes.php:2090
msgid "Max Record Time"
msgstr "حداکثر زمان ضبط"

#: lib/wfu_attributes.php:2102
msgid ""
"It defines the maximum time of video recording (in seconds). If it is set to "
"-1, then there is no time limit."
msgstr ""
"حداکثر زمان ضبط ویدیو (به ثانیه) را تعریف می‌کند. اگر روی -1 تنظیم شود، هیچ "
"محدودیت زمانی وجود ندارد."

#: lib/wfu_attributes.php:2117
msgid "It defines the background color of the webcam capture box."
msgstr "رنگ پس‌زمینه کادر ضبط وب‌کم را تعریف می‌کند."

#. plugin default values
#: lib/wfu_constants.php:30
msgid "Upload files"
msgstr "بارگذاری فایل ها"

#: lib/wfu_constants.php:31
msgid "Select File"
msgstr "انتخاب فایل"

#: lib/wfu_constants.php:32
msgid "Upload File"
msgstr "بارگذاری فایل"

#: lib/wfu_constants.php:33
msgid "File Upload Notification"
msgstr "اطلاع رسانی بارگذاری فایل"

#: lib/wfu_constants.php:34
#, php-format
msgid ""
"Dear Recipient,%%n%%%%n%%   This is an automatic delivery message to notify "
"you that a new file has been uploaded.%%n%%%%n%%Best Regards"
msgstr ""
"گیرنده گرامی،%%n%%%%n%%   این یک پیام تحویل خودکار است که به شما اطلاع می‌دهد "
"یک فایل جدید بارگذاری شده است.%%n%%%%n%%با احترام"

#: lib/wfu_constants.php:35
#, php-format
msgid "File %%filename%% uploaded successfully"
msgstr "فایل %%filename%% با موفقیت بارگذاری شد"

#: lib/wfu_constants.php:36
#, php-format
msgid "File %%filename%% uploaded successfully but with warnings"
