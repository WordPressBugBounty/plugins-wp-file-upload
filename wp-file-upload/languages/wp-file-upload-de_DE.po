#. variables tool-tips
#: lib/wfu_constants.php:205
#, php-format
msgid ""
"Insert variable %%userid%% inside text. It will be replaced by the id of the "
"current user."
msgstr ""
"Fügen Sie die Variable %%userid%% in den Text ein. Sie wird durch die ID des "
"aktuellen Benutzers ersetzt."

#: lib/wfu_constants.php:206
#, php-format
msgid ""
"Insert variable %%username%% inside text. It will be replaced by the "
"username of the current user."
msgstr ""
"Fügen Sie die Variable %%username%% in den Text ein. Sie wird durch den "
"Benutzernamen des aktuellen Benutzers ersetzt."

#: lib/wfu_constants.php:207
#, php-format
msgid ""
"Insert variable %%useremail%% inside text. It will be replaced by the email "
"of the current user."
msgstr ""
"Fügen Sie die Variable %%useremail%% in den Text ein. Sie wird durch die E-"
"Mail-Adresse des aktuellen Benutzers ersetzt."

#: lib/wfu_constants.php:208
#, php-format
msgid ""
"Insert variable %%filename%% inside text. It will be replaced by the "
"filename of the uploaded file."
msgstr ""
"Fügen Sie die Variable %%filename%% in den Text ein. Sie wird durch den "
"Dateinamen der hochgeladenen Datei ersetzt."

#: lib/wfu_constants.php:209
#, php-format
msgid ""
"Insert variable %%filepath%% inside text. It will be replaced by the full "
"filepath of the uploaded file."
msgstr ""
"Fügen Sie die Variable %%filepath%% in den Text ein. Sie wird durch den "
"vollständigen Dateipfad der hochgeladenen Datei ersetzt."

#: lib/wfu_constants.php:210
#, php-format
msgid ""
"Insert variable %%blogid%% inside text. It will be replaced by the blog id "
"of the website."
msgstr ""
"Fügen Sie die Variable %%blogid%% in den Text ein. Sie wird durch die Blog-"
"ID der Website ersetzt."

#: lib/wfu_constants.php:211
#, php-format
msgid ""
"Insert variable %%pageid%% inside text. It will be replaced by the id of the "
"current page."
msgstr ""
"Fügen Sie die Variable %%pageid%% in den Text ein. Sie wird durch die ID der "
"aktuellen Seite ersetzt."

#: lib/wfu_constants.php:212
#, php-format
msgid ""
"Insert variable %%pagetitle%% inside text. It will be replaced by the title "
"of the current page."
msgstr ""
"Fügen Sie die Variable %%pagetitle%% in den Text ein. Sie wird durch den "
"Titel der aktuellen Seite ersetzt."

#: lib/wfu_constants.php:213
#, php-format
msgid ""
"Insert variable %%userdataXXX%% inside text. Select the user field from the "
"drop-down list. It will be replaced by the value that the user entered in "
"this field."
msgstr ""
"Fügen Sie die Variable %%userdataXXX%% in den Text ein. Wählen Sie das "
"Benutzerfeld aus der Dropdown-Liste aus. Sie wird durch den Wert ersetzt, "
"den der Benutzer in dieses Feld eingegeben hat."

#: lib/wfu_constants.php:214
#, php-format
msgid "Insert variable %%n%% inside text to denote a line change."
msgstr ""
"Fügen Sie die Variable %%n%% in den Text ein, um einen Zeilenumbruch zu "
"kennzeichnen."

