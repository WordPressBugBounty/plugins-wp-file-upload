msgstr ""
"Das Farbtriplett (Text-, Hintergrund- und Rahmenfarben) der Meldung von "
"Upload-Status 1 (Upload läuft mit Meldungen) des Uploader-Shortcodes."

#: lib/wfu_constants.php:469
msgid "State 2 Message Colors"
msgstr "Meldungsfarben für Status 2"

#: lib/wfu_constants.php:469
msgid ""
