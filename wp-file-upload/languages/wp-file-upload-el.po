#: lib/wfu_constants.php:443
msgid "FTPS Connection Timeout"
msgstr "Χρονικό Όριο Σύνδεσης FTPS"

#: lib/wfu_constants.php:443
msgid "Defines the timeout (in seconds) for an FTPS connection."
msgstr "Ορίζει το χρονικό όριο (σε δευτερόλεπτα) για μια σύνδεση FTPS."

#: lib/wfu_constants.php:444
msgid "Use Passive Mode for FTPS"
msgstr "Χρήση Παθητικής Λειτουργίας για FTPS"

#: lib/wfu_constants.php:444
msgid ""
"Defines whether PHP will use passive mode for FTPS operations like "
"file_exists, file_stat, file_size etc. It can be 'true' or 'false'."
msgstr ""
"Ορίζει εάν το PHP θα χρησιμοποιεί παθητική λειτουργία για λειτουργίες FTPS "
"όπως file_exists, file_stat, file_size κ.λπ. Μπορεί να είναι 'true' ή "
"'false'."

#: lib/wfu_constants.php:445
msgid "Force Use Passive Address for FTPS"
msgstr "Εξαναγκασμός Χρήσης Παθητικής Διεύθυνσης για FTPS"

#: lib/wfu_constants.php:445
msgid ""
"Defines whether PHP will use the passive address for FTPS uploads when in "
"passive mode. It can be 'true' or 'false'."
msgstr ""
"Ορίζει εάν το PHP θα χρησιμοποιεί την παθητική διεύθυνση για μεταφορτώσεις "
"FTPS όταν βρίσκεται σε παθητική λειτουργία. Μπορεί να είναι 'true' ή 'false'."

#: lib/wfu_constants.php:446
msgid "Ignore Remote Path in File Operations"
msgstr "Παράβλεψη Απομακρυσμένης Διαδρομής στις Λειτουργίες Αρχείων"

#: lib/wfu_constants.php:446
msgid ""
"Defines whether file functions, such as file_exists(), stat() etc. will be "
"ignored for remote (cloud) paths. It can be 'true' or 'false'."
msgstr ""
"Ορίζει εάν οι λειτουργίες αρχείων, όπως file_exists(), stat() κ.λπ. θα "
"παραβλέπονται για απομακρυσμένες (cloud) διαδρομές. Μπορεί να είναι 'true' ή "
"'false'."

#: lib/wfu_constants.php:447
msgid "Default Value of File Exists for Remote Paths"
msgstr "Προεπιλεγμένη Τιμή του File Exists για Απομακρυσμένες Διαδρομές"

#: lib/wfu_constants.php:447
msgid ""
"Defines the default value that will be returned when file_exists() function "
"is executed on a remote (cloud) path. It can be '*true', '*false', '*calc', "
"'true' or 'false'. If it starts with asterisk (*) then this variable takes "
"precedence over the more general WFU_FILEOPERATION_IGNOREREMOTE."
msgstr ""
"Ορίζει την προεπιλεγμένη τιμή που θα επιστρέφεται όταν η λειτουργία "
"file_exists() εκτελείται σε μια απομακρυσμένη (cloud) διαδρομή. Μπορεί να "
"είναι '*true', '*false', '*calc', 'true' ή 'false'. Εάν ξεκινά με αστερίσκο "
"(*), τότε αυτή η μεταβλητή υπερισχύει της πιο γενικής "
"WFU_FILEOPERATION_IGNOREREMOTE."

#: lib/wfu_constants.php:448
msgid "Default Value of Stat for Remote Paths"
msgstr "Προεπιλεγμένη Τιμή του Stat για Απομακρυσμένες Διαδρομές"

