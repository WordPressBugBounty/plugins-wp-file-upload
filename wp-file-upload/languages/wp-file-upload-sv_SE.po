#: lib/wfu_functions.php:7786
msgid "Iptanus File Upload Consent Status"
msgstr "Iptanus File Upload-samtyckesstatus"

#: lib/wfu_functions.php:7789
msgid "Consent Status"
msgstr "Samtyckesstatus"

#: lib/wfu_functions.php:7791
msgid "You have given your consent to store personal data."
msgstr "Du har gett ditt samtycke till att lagra personuppgifter."

#: lib/wfu_functions.php:7791
msgid "You have denied to store personal data."
msgstr "Du har nekat att lagra personuppgifter."

#: lib/wfu_functions.php:7791
