msgstr ""
"Definierar om filreservation är aktiv. Det kan vara 'true' eller 'false'."

#: lib/wfu_constants.php:461
msgid "File Reservation Life"
msgstr "Filreservationslivslängd"

#: lib/wfu_constants.php:461
msgid ""
