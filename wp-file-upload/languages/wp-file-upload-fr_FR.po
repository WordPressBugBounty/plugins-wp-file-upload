#, php-format
msgid ""
"Insert variable %%username%% inside text. It will be replaced by the "
"username of the current user."
msgstr ""
"Insérez la variable %%username%% dans le texte. Elle sera remplacée par le "
"nom d'utilisateur de l'utilisateur actuel."

#: lib/wfu_constants.php:207
#, php-format
msgid ""
"Insert variable %%useremail%% inside text. It will be replaced by the email "
"of the current user."
msgstr ""
"Insérez la variable %%useremail%% dans le texte. Elle sera remplacée par l'e-"
"mail de l'utilisateur actuel."

#: lib/wfu_constants.php:208
#, php-format
msgid ""
"Insert variable %%filename%% inside text. It will be replaced by the "
"filename of the uploaded file."
msgstr ""
"Insérez la variable %%filename%% dans le texte. Elle sera remplacée par le "
"nom du fichier envoyé."

#: lib/wfu_constants.php:209
#, php-format
msgid ""
"Insert variable %%filepath%% inside text. It will be replaced by the full "
"filepath of the uploaded file."
msgstr ""
"Insérez la variable %%filepath%% dans le texte. Elle sera remplacée par le "
"chemin complet du fichier envoyé."

#: lib/wfu_constants.php:210
#, php-format
msgid ""
"Insert variable %%blogid%% inside text. It will be replaced by the blog id "
"of the website."
msgstr ""
"Insérez la variable %%blogid%% dans le texte. Elle sera remplacée par l'id "
"du blog du site web."

#: lib/wfu_constants.php:211
#, php-format
msgid ""
"Insert variable %%pageid%% inside text. It will be replaced by the id of the "
"current page."
msgstr ""
"Insérez la variable %%pageid%% dans le texte. Elle sera remplacée par l'id "
"de la page actuelle."

#: lib/wfu_constants.php:212
#, php-format
msgid ""
"Insert variable %%pagetitle%% inside text. It will be replaced by the title "
"of the current page."
msgstr ""
"Insérez la variable %%pagetitle%% dans le texte. Elle sera remplacée par le "
"titre de la page actuelle."

#: lib/wfu_constants.php:213
#, php-format
msgid ""
"Insert variable %%userdataXXX%% inside text. Select the user field from the "
"drop-down list. It will be replaced by the value that the user entered in "
"this field."
msgstr ""
"Insérez la variable %%userdataXXX%% dans le texte. Sélectionnez le champ "
"utilisateur dans la liste déroulante. Elle sera remplacée par la valeur que "
"l'utilisateur a saisie dans ce champ."

#: lib/wfu_constants.php:214
#, php-format
msgid "Insert variable %%n%% inside text to denote a line change."
msgstr ""
"Insérez la variable %%n%% dans le texte pour indiquer un changement de ligne."

