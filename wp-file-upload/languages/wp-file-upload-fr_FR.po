#: lib/wfu_attributes.php:668 lib/wfu_attributes.php:700
#: lib/wfu_attributes.php:732
msgid "all items having the same group id belong to the same group"
msgstr ""
"tous les éléments ayant le même id de groupe appartiennent au même groupe"

#: lib/wfu_attributes.php:670 lib/wfu_attributes.php:702
msgid "enter the format of the list"
msgstr "saisissez le format de la liste"

#: lib/wfu_attributes.php:674
msgid "Dropdown"
msgstr "Menu déroulant"

#: lib/wfu_attributes.php:681 lib/wfu_attributes.php:713
msgid ""
"if checked, then an item from the dropdown list must be selected before file "
"upload"
msgstr ""
"si coché, un élément de la liste déroulante doit être sélectionné avant le "
"téléversement du fichier"

#: lib/wfu_attributes.php:706
msgid "Country List"
msgstr "Liste de pays"

#: lib/wfu_attributes.php:729
msgid "Suggested Items"
msgstr "Éléments suggérés"

#: lib/wfu_attributes.php:730
msgid ""
"enter a comma delimited list of suggested countries that will be shown on top"
msgstr ""
"saisissez une liste de pays suggérés séparés par des virgules qui seront "
"affichés en haut"

#: lib/wfu_attributes.php:734
msgid ""
"format how each country will be shown in the list&#10;the attributes "
"&#39;code&#39;, &#39;label&#39; and &#39;phone&#39; can be used&#10;if "
"format starts with &#39;flag&#39; then the flag of the country will also be "
