msgstr "voer een door komma's gescheiden lijst met items in"

#: lib/wfu_attributes.php:668 lib/wfu_attributes.php:700
#: lib/wfu_attributes.php:732
msgid "all items having the same group id belong to the same group"
msgstr "alle items met dezelfde groeps-id behoren tot dezelfde groep"

#: lib/wfu_attributes.php:670 lib/wfu_attributes.php:702
msgid "enter the format of the list"
msgstr "voer het formaat van de lijst in"

#: lib/wfu_attributes.php:674
msgid "Dropdown"
msgstr "Vervolgkeuzelijst"

#: lib/wfu_attributes.php:681 lib/wfu_attributes.php:713
msgid ""
"if checked, then an item from the dropdown list must be selected before file "
