msgid "Default Access Method"
msgstr "Standaard toegangsmethode"

#: lib/wfu_constants.php:295
msgid ""
"The default access method (of the website filesystem) of the uploader "
"shortcode. It can be 'normal' or 'ftp'."
msgstr ""
"De standaard toegangsmethode (van het bestandssysteem van de website) van de "
"uploader-shortcode. Deze kan 'normal' of 'ftp' zijn."

