msgid "Default Maximum File Size"
msgstr "Standaard maximale bestandsgrootte"

#: lib/wfu_constants.php:294
msgid ""
"The default maximum allowed file size of the uploader shortcode in "
"Megabytes. It can be any positive number."
msgstr ""
"De standaard maximaal toegestane bestandsgrootte van de uploader-shortcode "
"in Megabytes. Dit kan elk positief getal zijn."

