msgstr "Il file %%filename%% è stato caricato con successo"

#: lib/wfu_constants.php:36
#, php-format
msgid "File %%filename%% uploaded successfully but with warnings"
msgstr "Il file %%filename%% è stato caricato con successo ma con avvertimenti"

#: lib/wfu_constants.php:37
#, php-format
msgid "File %%filename%% not uploaded"
msgstr "Il file %%filename%% non è stato caricato"

#: lib/wfu_constants.php:38
#, php-format
msgid "File %%filename%% is being uploaded"
msgstr "Il file %%filename%% è in fase di caricamento"

#: lib/wfu_constants.php:39
msgid "Your message"
msgstr "Il tuo messaggio"

#: lib/wfu_constants.php:40
msgid "Please fill in the above words: "
msgstr "Compila con le parole qui sopra, grazie"

#: lib/wfu_constants.php:41
msgid "Upload Media"
msgstr "Carica media"

#: lib/wfu_constants.php:42
msgid "videostream"
msgstr "flusso video"

#: lib/wfu_constants.php:43
msgid "screenshot"
msgstr "schermata"

#: lib/wfu_constants.php:44
msgid ""
"By activating this option I agree to let the website keep my personal data"
msgstr ""
"Attivando questa opzione accetto di consentire al sito web di conservare i "
"miei dati personali"

#: lib/wfu_constants.php:45
msgid ""
"You have denied to let the website keep your personal data. Upload cannot "
"continue!"
msgstr ""
"Hai rifiutato di consentire al sito web di conservare i tuoi dati personali. "
"Il caricamento non può continuare!"

#: lib/wfu_constants.php:59
msgid "Remove Remote"
msgstr "Rimuovi remoto"

#: lib/wfu_constants.php:60
msgid "Remove this remote file"
msgstr "Rimuovi questo file remoto"

#: lib/wfu_constants.php:61
