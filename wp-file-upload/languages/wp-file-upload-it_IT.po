#: lib/wfu_admin_maintenance.php:369
#, php-format
msgid ""
"This will erase all files uploaded <b>%s ago or older</b> together with "
"associated records kept by the plugin in the database (like file metadata "
"and userdata)."
msgstr ""
"Questo cancellerà tutti i file caricati <b>%s fa o prima</b> insieme ai "
"record associati conservati dal plugin nel database (come i metadati del "
"file e i dati utente)."

#: lib/wfu_admin_maintenance.php:371
#, php-format
msgid ""
"This will erase all files uploaded <b>between %s and %s</b> together with "
"associated records kept by the plugin in the database (like file metadata "
"and userdata)."
msgstr ""
"Questo cancellerà tutti i file caricati <b>tra il %s e il %s</b> insieme ai "
"record associati conservati dal plugin nel database (come i metadati del "
"file e i dati utente)."

#: lib/wfu_admin_maintenance.php:373
msgid ""
"This will erase <b>ALL</b> files and associated records kept by the plugin "
"in the database (like file metadata and userdata)."
msgstr ""
"Questo cancellerà <b>TUTTI</b> i file e i record associati conservati dal "
"plugin nel database (come i metadati del file e i dati utente)."

