msgstr "Scegli File"

#: lib/wfu_constants.php:32
msgid "Upload File"
msgstr "Carica File"

#: lib/wfu_constants.php:33
msgid "File Upload Notification"
msgstr "Notifica di caricamento del file"

#: lib/wfu_constants.php:34
#, php-format
msgid ""
"Dear Recipient,%%n%%%%n%%   This is an automatic delivery message to notify "
"you that a new file has been uploaded.%%n%%%%n%%Best Regards"
msgstr ""
"Caro Destinatario,%%n%%%%n%%   Questo è un messaggio di consegna automatico "
"per informarti che è stato caricato un nuovo file.%%n%%%%n%%Cordiali saluti"

#: lib/wfu_constants.php:35
#, php-format
