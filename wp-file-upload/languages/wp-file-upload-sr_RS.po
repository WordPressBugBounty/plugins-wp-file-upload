msgstr "Podrazumevani tekst oznake ciljne fascikle shortcode-a za otpremanje."

#: lib/wfu_constants.php:323
msgid "Default Subfolders State"
msgstr "Podrazumevano stanje podfascikli"

#: lib/wfu_constants.php:323
msgid ""
"The default state of displaying or not a list of subfolders of the uploader "
"shortcode. It can be 'true' or 'false'."
msgstr ""
"Podrazumevano stanje prikazivanja ili neprikazivanja liste podfascikli "
"shortcode-a za otpremanje. Može biti 'true' ili 'false'."

#: lib/wfu_constants.php:324
msgid "Default Text of Subfolders Label"
msgstr "Podrazumevani tekst oznake podfascikli"

#: lib/wfu_constants.php:324
msgid "The default text of subfolders label of the uploader shortcode."
msgstr "Podrazumevani tekst oznake podfascikli shortcode-a za otpremanje."

#: lib/wfu_constants.php:325
msgid "Default Subfolders List"
msgstr "Podrazumevana lista podfascikli"

#: lib/wfu_constants.php:325
msgid ""
"The default list of subfolders of the uploader shortcode. Check plugin's "
"support page for syntax."
msgstr ""
"Podrazumevana lista podfascikli shortcode-a za otpremanje. Pogledajte "
"stranicu podrške dodatka za sintaksu."

#: lib/wfu_constants.php:326
msgid "Default Disable AJAX State"
msgstr "Podrazumevano stanje onemogućavanja AJAX-a"

#: lib/wfu_constants.php:326
msgid ""
"The default state of disabling or not AJAX functionality of the uploader "
"shortcode. It can be 'true' or 'false'."
msgstr ""
"Podrazumevano stanje onemogućavanja ili neonemogućavanja AJAX "
"funkcionalnosti shortcode-a za otpremanje. Može biti 'true' ili 'false'."

#: lib/wfu_constants.php:327
