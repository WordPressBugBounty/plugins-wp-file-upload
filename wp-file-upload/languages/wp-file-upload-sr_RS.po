#: lib/wfu_constants.php:285
msgid "Default Upload ID"
msgstr "Podrazumevani ID otpremanja"

#: lib/wfu_constants.php:285
msgid ""
"The default upload ID of the uploader shortcode. It can be any integer from "
"1 and above."
msgstr ""
"Podrazumevani ID otpremanja shortcode-a za otpremanje. Može biti bilo koji "
"ceo broj od 1 i naviše."

#: lib/wfu_constants.php:286
msgid "Default Single-Button Status"
msgstr "Podrazumevani status jednog dugmeta"

#: lib/wfu_constants.php:286
msgid ""
"The default single-button status of the uploader shortcode. It can be 'true' "
"or 'false'."
msgstr ""
"Podrazumevani status jednog dugmeta shortcode-a za otpremanje. Može biti "
"'true' ili 'false'."

#: lib/wfu_constants.php:287
msgid "Default Upload Role"
msgstr "Podrazumevana uloga otpremanja"

#: lib/wfu_constants.php:287
msgid ""
"The default upload role of the uploader shortcode. It can be a comma-"
"separated list of role slugs, including keywords 'all' and 'guests'."
msgstr ""
"Podrazumevana uloga za otpremanje shortcode-a za otpremanje. Može biti lista "
"slug-ova uloga razdvojenih zarezom, uključujući ključne reči 'all' i "
"'guests'."

#: lib/wfu_constants.php:288
msgid "Default Upload Path"
msgstr "Podrazumevana putanja za otpremanje"

#: lib/wfu_constants.php:288
msgid ""
"The default upload path of the uploader shortcode. It must be a folder "
"relative to wp-content dir."
msgstr ""
"Podrazumevana putanja za otpremanje shortcode-a za otpremanje. Mora biti "
"fascikla relativna u odnosu na wp-content direktorijum."

#: lib/wfu_constants.php:289
msgid "Default Fit Mode"
msgstr "Podrazumevani režim uklapanja"

#: lib/wfu_constants.php:289
msgid ""
"The default fit mode of the uploader shortcode. It can be 'fixed' or "
"'responsive'."
msgstr ""
"Podrazumevani režim uklapanja shortcode-a za otpremanje. Može biti 'fixed' "
"ili 'responsive'."

#: lib/wfu_constants.php:290
msgid "Default Allow No File Mode"
msgstr "Podrazumevani režim dozvole bez datoteke"

#: lib/wfu_constants.php:290
msgid ""
"The default mode for allowing no file uploads. If it is set to 'true' then "
"an upload form can be submitted even if a file has not been selected. It can "
"be 'true' or 'false'."
msgstr ""
"Podrazumevani režim za dozvolu otpremanja bez datoteke. Ako je postavljeno "
"na 'true', forma za otpremanje može biti poslata čak i ako datoteka nije "
"izabrana. Može biti 'true' ili 'false'."

#: lib/wfu_constants.php:291
msgid "Default Reset Form Mode"
msgstr "Podrazumevani režim resetovanja forme"

#: lib/wfu_constants.php:291
msgid ""
"The default reset mode of the upload form. It can be 'always', 'onsuccess' "
"or 'never'."
msgstr ""
"Podrazumevani režim resetovanja forme za otpremanje. Može biti 'always', "
"'onsuccess' ili 'never'."

#: lib/wfu_constants.php:292
msgid "Default Force Filename State"
msgstr "Podrazumevano stanje primoravanja naziva datoteke"

#: lib/wfu_constants.php:292
msgid ""
"The default force filename state (force plugin to leave filename unchanged) "
"of the uploader shortcode. It can be 'true' or 'false'."
msgstr ""
"Podrazumevano stanje primoravanja naziva datoteke (primoraj dodatak da "
"ostavi naziv datoteke nepromenjen) shortcode-a za otpremanje. Može biti "
"'true' ili 'false'."

#: lib/wfu_constants.php:293
msgid "Default Upload Extensions"
msgstr "Podrazumevane ekstenzije za otpremanje"

#: lib/wfu_constants.php:293
msgid ""
"The default allowed file extensions of the uploader shortcode. It can be a "
"comma-separated list of wildcard extensions."
msgstr ""
"Podrazumevane dozvoljene ekstenzije datoteka shortcode-a za otpremanje. Može "
"biti lista džoker ekstenzija razdvojenih zarezom."

#: lib/wfu_constants.php:294
msgid "Default Maximum File Size"
msgstr "Podrazumevana maksimalna veličina datoteke"

#: lib/wfu_constants.php:294
msgid ""
"The default maximum allowed file size of the uploader shortcode in "
"Megabytes. It can be any positive number."
msgstr ""
"Podrazumevana maksimalna dozvoljena veličina datoteke shortcode-a za "
"otpremanje u Megabajtima. Može biti bilo koji pozitivan broj."

#: lib/wfu_constants.php:295
msgid "Default Access Method"
msgstr "Podrazumevani metod pristupa"

#: lib/wfu_constants.php:295
msgid ""
"The default access method (of the website filesystem) of the uploader "
"shortcode. It can be 'normal' or 'ftp'."
msgstr ""
"Podrazumevani metod pristupa (fajl sistemu sajta) shortcode-a za otpremanje. "
"Može biti 'normal' ili 'ftp'."

#: lib/wfu_constants.php:296
msgid "Default FTP Access Information"
msgstr "Podrazumevane FTP informacije za pristup"

#: lib/wfu_constants.php:296
msgid ""
"The default FTP access parameters of the uploader shortcode. It's syntax is "
"'username:password@ftp_domain'."
msgstr ""
"Podrazumevani FTP parametri pristupa shortcode-a za otpremanje. Njegova "
"sintaksa je 'username:password@ftp_domain'."

#: lib/wfu_constants.php:297
msgid "Default Use FTP Domain State"
msgstr "Podrazumevano stanje korišćenja FTP domena"

#: lib/wfu_constants.php:297
msgid ""
"The default use FTP domain state (use the FTP domain defined in ftpinfo to "
"store the uploaded files) of the uploader shortcode. It can be 'true' or "
"'false'."
msgstr ""
"Podrazumevano stanje korišćenja FTP domena (koristi FTP domen definisan u "
"ftpinfo za čuvanje otpremljenih datoteka) shortcode-a za otpremanje. Može "
"biti 'true' ili 'false'."

#: lib/wfu_constants.php:298
msgid "Default FTP Passive Mode State"
msgstr "Podrazumevano stanje FTP pasivnog režima"

#: lib/wfu_constants.php:298 lib/wfu_constants.php:299
msgid ""
"The default FTP passive mode (use passive mode or not for FTP access) of the "
"uploader shortcode. It can be 'true' or 'false'."
msgstr ""
"Podrazumevani FTP pasivni režim (koristi pasivni režim ili ne za FTP "
"pristup) shortcode-a za otpremanje. Može biti 'true' ili 'false'."

#: lib/wfu_constants.php:299
msgid "Default FTP File Permissions"
msgstr "Podrazumevane FTP dozvole datoteke"

#: lib/wfu_constants.php:300
msgid "Default Duplicate File Action"
msgstr "Podrazumevana radnja duplikata datoteke"

#: lib/wfu_constants.php:300
msgid ""
"The default duplicate file action of the uploader shortcode. It can be "
"'overwrite', 'reject' or 'mantain both'."
msgstr ""
"Podrazumevana radnja duplikata datoteke shortcode-a za otpremanje. Može biti "
"'overwrite', 'reject' ili 'mantain both'."

#: lib/wfu_constants.php:301
msgid "Default Duplicate File Pattern"
msgstr "Podrazumevani obrazac duplikata datoteke"

#: lib/wfu_constants.php:301
msgid ""
"The default duplicate file pattern of the uploader shortcode. It can be "
"'index' or 'datetimestamp'."
msgstr ""
"Podrazumevani obrazac duplikata datoteke shortcode-a za otpremanje. Može "
"biti 'index' ili 'datetimestamp'."

#: lib/wfu_constants.php:302
msgid "Default WPFilebase Update State"
msgstr "Podrazumevano stanje WPFilebase ažuriranja"

#: lib/wfu_constants.php:302
msgid ""
"The default WPFilebase plugin update state of the uploader shortcode. It can "
"be 'true' or 'false'."
msgstr ""
"Podrazumevano stanje ažuriranja WPFilebase dodatka shortcode-a za "
"otpremanje. Može biti 'true' ili 'false'."

#: lib/wfu_constants.php:303
msgid "Default Email Notification State"
msgstr "Podrazumevano stanje obaveštenja putem imejla"

#: lib/wfu_constants.php:303
msgid ""
"The default email notification state of the uploader shortcode. It can be "
"'true' or 'false'."
msgstr ""
"Podrazumevano stanje obaveštenja putem imejla shortcode-a za otpremanje. "
"Može biti 'true' ili 'false'."

